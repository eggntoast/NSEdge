<Window x:Class="NSEdge.App.LightingConfirmationWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Turn on lighting? · NSEdge" Width="430" SizeToContent="Height"
 ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 Background="{StaticResource BaseBrush}" Foreground="{StaticResource PrimaryTextBrush}"
 FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <StackPanel Margin="24,22">
  <TextBlock Text="Turn on controller lighting?" FontSize="20" FontWeight="SemiBold"
             TextWrapping="Wrap" Margin="0,0,0,12"/>
  <TextBlock Text="This feature is still being tested. It won't change the lights while DS4Windows is running, and the previous colour may not return automatically."
             FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}"
             Margin="0,0,0,20"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="Cancel" Style="{StaticResource ActionButtonStyle}"
           Margin="0,0,8,0" Click="CancelClick"/>
   <Button Content="Turn on" Style="{StaticResource PrimaryButtonStyle}"
           MinWidth="100" Click="ConfirmClick"/>
  </StackPanel>
 </StackPanel>
</Window>
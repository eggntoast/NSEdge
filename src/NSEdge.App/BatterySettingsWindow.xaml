<Window x:Class="NSEdge.App.BatterySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery settings · NSEdge" Width="488" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BaseBrush}" Foreground="{StaticResource PrimaryTextBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        SourceInitialized="OnSourceInitialized">
    <StackPanel Margin="23,22,23,22">
        <TextBlock Text="Battery settings" FontSize="22" FontWeight="SemiBold"
                   Foreground="{StaticResource PrimaryTextBrush}"/>
        <TextBlock Text="Battery popups and alerts"
                   Style="{StaticResource SecondaryLabel}" Margin="0,6,0,19"/>
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,9">
            <StackPanel>
                <Grid Height="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PS-button popup" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="Show battery data when PS is pressed" Style="{StaticResource SecondaryLabel}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="PsBatteryCheck" Style="{StaticResource SettingToggleStyle}"
                                  VerticalAlignment="Center" AutomationProperties.Name="PS-button battery popup"
                                  Checked="SettingChanged" Unchecked="SettingChanged"/>
                </Grid>
                <Border Height="1" Background="{StaticResource BorderBrush}"/>
                <Grid Height="64">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Low-battery alerts" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="Warn when the battery gets low"
                                   Style="{StaticResource SecondaryLabel}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" x:Name="LowBatteryCheck" Style="{StaticResource SettingToggleStyle}"
                                  VerticalAlignment="Center" AutomationProperties.Name="Enable low-battery alerts"
                                  Checked="SettingChanged" Unchecked="SettingChanged"/>
                </Grid>
            </StackPanel>
        </Border>
        <Grid Margin="0,18,0,0" Height="65">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Low-battery threshold" Style="{StaticResource SettingLabel}"/>
            <TextBlock x:Name="ThresholdText" Grid.Column="1" Text="20%"
                       Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
            <Slider x:Name="ThresholdSlider" Grid.Row="1" Grid.ColumnSpan="2"
                    Minimum="10" Maximum="50" TickFrequency="10" IsSnapToTickEnabled="True"
                    Style="{StaticResource DurationSliderStyle}" Margin="2,8,2,0"
                    AutomationProperties.Name="Low-battery warning threshold, percent"
                    ValueChanged="SettingChanged"/>
        </Grid>
        <TextBlock Text="Battery levels are reported in 10% bands, not precise percentages."
                   Style="{StaticResource SecondaryLabel}" TextWrapping="Wrap" Margin="0,4,0,17"/>
        <Button Content="Done" HorizontalAlignment="Right" Width="88"
                Style="{StaticResource PrimaryButtonStyle}" Click="DoneClick"/>
    </StackPanel>
</Window>
<Window x:Class="NSEdge.App.Overlays.BatteryOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" Width="365" Height="106"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Grid Margin="8">
        <Border Background="#F40E1420" BorderBrush="#35465B" BorderThickness="1"
                CornerRadius="12" Padding="17,13">
            <Border.Effect>
                <DropShadowEffect BlurRadius="17" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" Background="#26374B" CornerRadius="8"
                        VerticalAlignment="Center">
                    <Viewbox Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="2" Canvas.Top="6" Width="18" Height="12" RadiusX="3" RadiusY="3"
                                       Stroke="#75B8FF" StrokeThickness="2" Fill="Transparent"/>
                            <Rectangle Canvas.Left="21" Canvas.Top="10" Width="2" Height="4" RadiusX="1" RadiusY="1"
                                       Fill="#75B8FF"/>
                            <Rectangle Canvas.Left="5" Canvas.Top="9" Width="10" Height="6" RadiusX="1" RadiusY="1"
                                       Fill="#75B8FF"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="Heading" Text="DUALSENSE EDGE  ·  BATTERY"
                               Foreground="#AAB9CC" FontSize="10" FontWeight="SemiBold"/>
                    <TextBlock x:Name="Reading" Text="Battery unavailable"
                               Foreground="#F2F6FC" FontSize="18" FontWeight="SemiBold"
                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
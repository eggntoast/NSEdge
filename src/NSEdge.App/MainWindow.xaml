<Window x:Class="NSEdge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NSEdge" Icon="Assets/NSEdge.ico"
        Width="514" Height="510" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Closing="OnClosing" Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="23,19,23,18">
            <Grid Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource RaisedBrush}" VerticalAlignment="Center">
                    <Viewbox Width="29" Height="29" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="48" Height="48">
                            <Path Data="M 32,9 H 17 C 13,9 12,12 12,17 V 31 C 12,35 14,38 18,38 H 32 M 17,24 H 31"
                                  Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="4" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M 28,17 L 35,24 L 28,31" Stroke="{StaticResource AccentBrush}" StrokeThickness="4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="NSEdge" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                    <TextBlock Text="DualSense Edge companion" Style="{StaticResource SecondaryLabel}"/>
                </StackPanel>
                <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="11"
                        VerticalAlignment="Center" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Name="StatusDot" Width="7" Height="7" Fill="{StaticResource OfflineBrush}" VerticalAlignment="Center"/>
                        <TextBlock Name="ConnectionBadgeText" Margin="7,0,0,0" Text="Searching" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Margin="0,18,0,16" Padding="17,13">
                <StackPanel>
                    <TextBlock Text="ACTIVE ONBOARD PROFILE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <Grid Margin="0,7,0,7">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Name="ProfileText" Text="Waiting for input" FontSize="21" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <Border Grid.Column="1" Margin="12,0,0,0" Padding="9,4" CornerRadius="6"
                                Background="{StaticResource RaisedBrush}" VerticalAlignment="Center">
                            <TextBlock Name="ShortcutText" Text="—" FontSize="11"
                                       Foreground="{StaticResource PrimaryTextBrush}"/>
                        </Border>
                    </Grid>
                    <TextBlock Name="ConnectionText" Text="Searching for DualSense Edge over USB"
                               Style="{StaticResource SecondaryLabel}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="PREFERENCES" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource SecondaryTextBrush}" Margin="0,1,0,12"/>
            <Grid Height="53">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Profile notifications" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="Notify when an onboard profile changes" Style="{StaticResource SecondaryLabel}" Margin="0,3,0,0"/>
                </StackPanel>
                <ToggleButton Grid.Column="1" Name="NotificationsCheck" Style="{StaticResource SettingToggleStyle}"
                              AutomationProperties.Name="Profile notifications" VerticalAlignment="Center"
                              Checked="SettingChanged" Unchecked="SettingChanged"/>
            </Grid>
            <Grid Height="53">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Start with Windows" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="Run NSEdge quietly in the system tray" Style="{StaticResource SecondaryLabel}" Margin="0,3,0,0"/>
                </StackPanel>
                <ToggleButton Grid.Column="1" Name="AutostartCheck" Style="{StaticResource SettingToggleStyle}"
                              AutomationProperties.Name="Start NSEdge with Windows" VerticalAlignment="Center"
                              Checked="AutostartChanged" Unchecked="AutostartChanged"/>
            </Grid>
            <Grid Margin="0,15,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Notification duration" Style="{StaticResource SettingLabel}"/>
                <TextBlock Grid.Column="1" Name="DurationText" Foreground="{StaticResource SecondaryTextBrush}" Text="2.5 s"/>
                <Slider Grid.Row="1" Grid.ColumnSpan="2" Name="DurationSlider" Margin="2,8,2,0"
                        Style="{StaticResource DurationSliderStyle}" Minimum="1" Maximum="10"
                        TickFrequency="0.5" IsSnapToTickEnabled="True" Value="2.5"
                        AutomationProperties.Name="Notification duration in seconds"
                        ValueChanged="SettingChanged"/>
            </Grid>
            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,19,0,15"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Name="VersionText" Text="Developed by NS" Style="{StaticResource SecondaryLabel}"/>
                    <TextBlock Text="Read-only controller monitoring" Style="{StaticResource SecondaryLabel}" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Refresh names" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"
                            Click="RefreshClick" ToolTip="Read saved profile names from the controller"/>
                    <Button Content="Show profile" Style="{StaticResource PrimaryButtonStyle}" Click="ShowCurrentClick"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
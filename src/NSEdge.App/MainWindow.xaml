<Window x:Class="NSEdge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NSEdge" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BaseBrush}"
        Foreground="{StaticResource PrimaryTextBrush}" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        SourceInitialized="OnSourceInitialized" Closing="OnClosing" Loaded="OnLoaded">
  <ScrollViewer x:Name="ContentViewport" VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel x:Name="ContentLayout" Margin="24,18,24,20">
      <Grid Height="48" Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource RaisedBrush}"
                VerticalAlignment="Center" HorizontalAlignment="Left">
          <Viewbox Width="29" Height="29">
            <Canvas Width="48" Height="48">
              <Path Data="M 32,9 H 17 C 13,9 12,12 12,17 V 31 C 12,35 14,38 18,38 H 32 M 17,24 H 31"
                    Stroke="{StaticResource PrimaryTextBrush}" StrokeThickness="4" StrokeLineJoin="Round"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Path Data="M 28,17 L 35,24 L 28,31" Stroke="{StaticResource AccentBrush}" StrokeThickness="4"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Canvas>
          </Viewbox>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
          <TextBlock Text="NSEdge" FontSize="21" FontWeight="SemiBold"/>
          <TextBlock Text="DualSense Edge" Style="{StaticResource SecondaryLabel}" Margin="0,1,0,0"/>
        </StackPanel>
        <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                VerticalAlignment="Center" Padding="11,6">
          <StackPanel Orientation="Horizontal">
            <Ellipse Name="StatusDot" Width="7" Height="7" Fill="{StaticResource OfflineBrush}" VerticalAlignment="Center"/>
            <TextBlock Name="ConnectionBadgeText" Margin="7,0,0,0" Text="Searching" FontSize="12"
                       Foreground="{StaticResource SecondaryTextBrush}"/>
          </StackPanel>
        </Border>
        <Button x:Name="SettingsGearButton" Grid.Column="3" Width="38" Height="38"
                Style="{StaticResource ActionButtonStyle}"
                Margin="10,0,0,0" VerticalAlignment="Center"
                Content="⚙" FontFamily="Segoe UI Symbol" FontSize="21"
                Foreground="{StaticResource PrimaryTextBrush}"
                Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" Cursor="Hand"
                Click="OpenGearClick" ToolTip="NSEdge options"
                AutomationProperties.Name="Open NSEdge options menu"/>
      </Grid>

      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="12" Padding="17,15" Margin="0,0,0,17">
        <StackPanel>
          <TextBlock Text="ACTIVE PROFILE" Style="{StaticResource EyebrowLabel}"/>
          <Grid Margin="0,9,0,7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Name="ProfileText" Text="Waiting for controller" FontSize="21" FontWeight="SemiBold"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <Border Grid.Column="1" Margin="12,0,0,0" Padding="10,6" CornerRadius="7"
                    Background="{StaticResource RaisedBrush}" VerticalAlignment="Center">
              <TextBlock Name="ShortcutText" Text="—" FontSize="12"/>
            </Border>
          </Grid>
          <TextBlock Name="ConnectionText" Text="Looking for DualSense Edge"
                     Style="{StaticResource SecondaryLabel}" TextTrimming="CharacterEllipsis"
                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
          <TextBlock Name="BatteryText" Text="Battery unavailable" Style="{StaticResource SecondaryLabel}"
                     Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>

      <TextBlock Text="LIGHTING" Style="{StaticResource EyebrowLabel}" Margin="0,0,0,6"/>
      <Grid MinHeight="70" Margin="0,0,0,11">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="LightingPreviewDot" Width="12" Height="12" Fill="{StaticResource BorderBrush}"
                     VerticalAlignment="Center" Margin="0,0,9,0"/>
            <TextBlock x:Name="LightingModeText" Text="Off" Style="{StaticResource SettingLabel}"/>
          </StackPanel>
          <TextBlock x:Name="LightingStatusText" Text="Controller lighting is off"
                     Style="{StaticResource SecondaryLabel}" Margin="0,5,0,0"
                     TextWrapping="Wrap" MaxWidth="285"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Customize" Style="{StaticResource ActionButtonStyle}"
                VerticalAlignment="Center" Click="LightingOptionsClick"
                AutomationProperties.Name="Customize controller lighting"/>
      </Grid>
      <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,15"/>

      <TextBlock Text="NOTIFICATIONS" Style="{StaticResource EyebrowLabel}" Margin="0,0,0,7"/>
      <Grid Height="62">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Profile change alerts" Style="{StaticResource SettingLabel}"/>
          <TextBlock Text="Show a popup when you switch profiles" Style="{StaticResource SecondaryLabel}" Margin="0,4,0,0"/>
        </StackPanel>
        <ToggleButton Grid.Column="1" Name="NotificationsCheck" Style="{StaticResource SettingToggleStyle}"
                      AutomationProperties.Name="Show profile change alerts" VerticalAlignment="Center"
                      Checked="SettingChanged" Unchecked="SettingChanged"/>
      </Grid>
      <Grid Height="57" Margin="0,0,0,13">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Popup duration" Style="{StaticResource SettingLabel}"/>
        <TextBlock Grid.Column="1" Name="DurationText" Foreground="{StaticResource SecondaryTextBrush}"
                   Text="2.5 s" FontSize="12"/>
        <Slider Grid.Row="1" Grid.ColumnSpan="2" Name="DurationSlider" Margin="2,8,2,0"
                Style="{StaticResource DurationSliderStyle}" Minimum="1" Maximum="10"
                TickFrequency="0.5" IsSnapToTickEnabled="True" Value="2.5"
                AutomationProperties.Name="Popup duration in seconds" ValueChanged="SettingChanged"/>
      </Grid>
      <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,15"/>

      <TextBlock Text="BATTERY" Style="{StaticResource EyebrowLabel}" Margin="0,0,0,6"/>
      <Grid x:Name="BatterySection" Height="66" Margin="0,0,0,11">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Battery alerts" Style="{StaticResource SettingLabel}"/>
          <TextBlock Text="PS-button popup and low-battery warnings"
                     Style="{StaticResource SecondaryLabel}" Margin="0,4,0,0"/>
        </StackPanel>
        <Button Grid.Column="1" Content="Settings" Style="{StaticResource ActionButtonStyle}"
                VerticalAlignment="Center" Click="BatteryOptionsClick"
                AutomationProperties.Name="Battery alert settings"/>
      </Grid>
      <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,15"/>

    </StackPanel>
  </ScrollViewer>
</Window>
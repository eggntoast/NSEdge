<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NSEdge</AssemblyName>
    <RootNamespace>NSEdge.App</RootNamespace>
    <Version>0.4</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <InformationalVersion>0.4</InformationalVersion>
    <Authors>NS</Authors>
    <Copyright>Copyright (c) 2026 NS</Copyright>
    <Description>DualSense Edge controller companion</Description>
    <ApplicationIcon>Assets\NSEdge.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\NSEdge.ico" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../NSEdge.Core/NSEdge.Core.csproj" />
    <ProjectReference Include="../NSEdge.Windows/NSEdge.Windows.csproj" />
  </ItemGroup>
</Project>

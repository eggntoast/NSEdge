<Window x:Class="NSEdge.App.ColorPickerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Choose colour · NSEdge" Width="410" SizeToContent="Height"
 ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 Background="{StaticResource BaseBrush}" Foreground="{StaticResource PrimaryTextBrush}"
 FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <StackPanel Margin="24,22">
  <TextBlock Text="Choose colour" FontSize="21" FontWeight="SemiBold"/>
  <TextBlock Text="Adjust the sliders or enter a HEX colour"
             Style="{StaticResource SecondaryLabel}" Margin="0,5,0,17"/>
  <Border x:Name="ColorPreview" Height="75" CornerRadius="10"
          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
          Margin="0,0,0,18"/>
  <Grid Margin="0,0,0,15">
   <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
   <TextBlock Text="Red" VerticalAlignment="Center"/>
   <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1"
           IsSnapToTickEnabled="True" Style="{StaticResource DurationSliderStyle}"
           ValueChanged="SliderChanged" VerticalAlignment="Center"
           AutomationProperties.Name="Red channel"/>
   <TextBlock x:Name="RedValue" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"/>
   <TextBlock Text="Green" Grid.Row="1" VerticalAlignment="Center"/>
   <Slider x:Name="GreenSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1"
           IsSnapToTickEnabled="True" Style="{StaticResource DurationSliderStyle}"
           ValueChanged="SliderChanged" VerticalAlignment="Center"
           AutomationProperties.Name="Green channel"/>
   <TextBlock x:Name="GreenValue" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"/>
   <TextBlock Text="Blue" Grid.Row="2" VerticalAlignment="Center"/>
   <Slider x:Name="BlueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" TickFrequency="1"
           IsSnapToTickEnabled="True" Style="{StaticResource DurationSliderStyle}"
           ValueChanged="SliderChanged" VerticalAlignment="Center"
           AutomationProperties.Name="Blue channel"/>
   <TextBlock x:Name="BlueValue" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"/>
  </Grid>
  <TextBlock Text="HEX colour" Style="{StaticResource SettingLabel}" Margin="0,0,0,6"/>
  <TextBox x:Name="HexText" Style="{StaticResource DarkTextBoxStyle}" MaxLength="7"
           TextChanged="HexChanged" AutomationProperties.Name="HEX colour value" Margin="0,0,0,3"/>
  <TextBlock x:Name="ErrorText" Foreground="#FFB7B7" FontSize="12"
             Text="Use a six-digit colour such as #75B8FF"
             Margin="0,0,0,9" Visibility="Collapsed"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
   <Button Content="Cancel" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"
           Click="CancelClick"/>
   <Button Content="Use colour" Style="{StaticResource PrimaryButtonStyle}" Click="AcceptClick"
           MinWidth="100"/>
  </StackPanel>
 </StackPanel>
</Window>
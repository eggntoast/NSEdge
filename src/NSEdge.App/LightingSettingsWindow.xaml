<Window x:Class="NSEdge.App.LightingSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Lighting · NSEdge" Width="488" SizeToContent="Height"
 ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 Background="{StaticResource BaseBrush}" Foreground="{StaticResource PrimaryTextBrush}"
 FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
 SourceInitialized="OnSourceInitialized">
 <ScrollViewer x:Name="ContentViewport" VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="24,20">
   <TextBlock Text="Lighting" FontSize="22" FontWeight="SemiBold"/>
   <TextBlock Text="Choose how your controller lights up"
              Style="{StaticResource SecondaryLabel}" Margin="0,5,0,17"/>
   <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
           BorderThickness="1" CornerRadius="10" Padding="15,12" Margin="0,0,0,12">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="Control controller lights" Style="{StaticResource SettingLabel}"/>
      <TextBlock Text="Uses NSEdge lighting when available" Style="{StaticResource SecondaryLabel}" Margin="0,4,0,0"/>
     </StackPanel>
     <ToggleButton x:Name="EnabledToggle" Grid.Column="1" Style="{StaticResource SettingToggleStyle}"
                   VerticalAlignment="Center" AutomationProperties.Name="Control controller lights"/>
    </Grid>
   </Border>
   <TextBlock x:Name="LightingStatusText" Style="{StaticResource SecondaryLabel}"
              TextWrapping="Wrap" Margin="2,0,0,14"/>
   <TextBlock Text="Lighting style" Style="{StaticResource SettingLabel}" Margin="0,0,0,6"/>
   <ComboBox x:Name="ModeSelector" Style="{StaticResource DarkComboBoxStyle}"
             Margin="0,0,0,15" SelectionChanged="ModeChanged"
             AutomationProperties.Name="Lighting style">
     <ComboBoxItem Content="Battery level" Style="{StaticResource DarkComboBoxItemStyle}"/>
     <ComboBoxItem Content="Battery gradient" Style="{StaticResource DarkComboBoxItemStyle}"/>
     <ComboBoxItem Content="Single colour" Style="{StaticResource DarkComboBoxItemStyle}"/>
   </ComboBox>

   <StackPanel x:Name="BatteryPalettePanel">
    <TextBlock Text="Battery colours" Style="{StaticResource SettingLabel}" Margin="0,0,0,5"/>
    <TextBlock Text="Pick a colour for each battery level"
               Style="{StaticResource SecondaryLabel}" Margin="0,0,0,10"/>
    <UniformGrid Columns="2" Rows="3">
     <Button Tag="Critical" Click="PickColorClick" Style="{StaticResource ActionButtonStyle}"
             Height="43" Margin="0,0,6,8" AutomationProperties.Name="Choose very low battery colour">
      <StackPanel Orientation="Horizontal">
       <Border x:Name="CriticalSwatch" Width="22" Height="22" CornerRadius="5" Margin="0,0,9,0"
               BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
       <TextBlock Text="Very low" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Button Tag="Low" Click="PickColorClick" Style="{StaticResource ActionButtonStyle}"
             Height="43" Margin="6,0,0,8" AutomationProperties.Name="Choose low battery colour">
      <StackPanel Orientation="Horizontal">
       <Border x:Name="LowSwatch" Width="22" Height="22" CornerRadius="5" Margin="0,0,9,0"
               BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
       <TextBlock Text="Low" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Button Tag="Medium" Click="PickColorClick" Style="{StaticResource ActionButtonStyle}"
             Height="43" Margin="0,0,6,8" AutomationProperties.Name="Choose medium battery colour">
      <StackPanel Orientation="Horizontal">
       <Border x:Name="MediumSwatch" Width="22" Height="22" CornerRadius="5" Margin="0,0,9,0"
               BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
       <TextBlock Text="Medium" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Button Tag="High" Click="PickColorClick" Style="{StaticResource ActionButtonStyle}"
             Height="43" Margin="6,0,0,8" AutomationProperties.Name="Choose high battery colour">
      <StackPanel Orientation="Horizontal">
       <Border x:Name="HighSwatch" Width="22" Height="22" CornerRadius="5" Margin="0,0,9,0"
               BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
       <TextBlock Text="High" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Button Tag="Charging" Click="PickColorClick" Style="{StaticResource ActionButtonStyle}"
             Height="43" Margin="0,0,6,8" AutomationProperties.Name="Choose charging colour">
      <StackPanel Orientation="Horizontal">
       <Border x:Name="ChargingSwatch" Width="22" Height="22" CornerRadius="5" Margin="0,0,9,0"
               BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
       <TextBlock Text="Charging" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
     <Button Tag="Full" Click="PickColorClick" Style="{StaticResource ActionButtonStyle}"
             Height="43" Margin="6,0,0,8" AutomationProperties.Name="Choose fully charged colour">
      <StackPanel Orientation="Horizontal">
       <Border x:Name="FullSwatch" Width="22" Height="22" CornerRadius="5" Margin="0,0,9,0"
               BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
       <TextBlock Text="Fully charged" VerticalAlignment="Center"/>
      </StackPanel>
     </Button>
    </UniformGrid>
   </StackPanel>
   <StackPanel x:Name="StaticPalettePanel" Visibility="Collapsed">
    <TextBlock Text="Single colour" Style="{StaticResource SettingLabel}" Margin="0,0,0,8"/>
    <Button Tag="Static" Click="PickColorClick" Style="{StaticResource ActionButtonStyle}"
            Height="46" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
            Margin="0,0,0,14" AutomationProperties.Name="Choose single lighting colour">
     <StackPanel Orientation="Horizontal">
      <Border x:Name="StaticSwatch" Width="24" Height="24" CornerRadius="5" Margin="0,0,10,0"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
      <TextBlock Text="Choose colour…" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
   </StackPanel>
   <Button x:Name="AdvancedButton" Content="Advanced settings"
           Style="{StaticResource ActionButtonStyle}" HorizontalAlignment="Left"
           Margin="0,0,0,12" Click="AdvancedClick"
           AutomationProperties.Name="Show advanced colour and battery range settings"/>
   <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed">
    <TextBlock Text="Exact colours (HEX)" Style="{StaticResource SettingLabel}" Margin="0,0,0,8"/>
    <UniformGrid Columns="2" Rows="4">
     <StackPanel Margin="0,0,7,10"><TextBlock Text="Very low" Style="{StaticResource SecondaryLabel}"/>
      <TextBox x:Name="CriticalText" Style="{StaticResource DarkTextBoxStyle}" MaxLength="7" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Margin="7,0,0,10"><TextBlock Text="Low" Style="{StaticResource SecondaryLabel}"/>
      <TextBox x:Name="LowText" Style="{StaticResource DarkTextBoxStyle}" MaxLength="7" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Margin="0,0,7,10"><TextBlock Text="Medium" Style="{StaticResource SecondaryLabel}"/>
      <TextBox x:Name="MediumText" Style="{StaticResource DarkTextBoxStyle}" MaxLength="7" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Margin="7,0,0,10"><TextBlock Text="High" Style="{StaticResource SecondaryLabel}"/>
      <TextBox x:Name="HighText" Style="{StaticResource DarkTextBoxStyle}" MaxLength="7" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Margin="0,0,7,10"><TextBlock Text="Charging" Style="{StaticResource SecondaryLabel}"/>
      <TextBox x:Name="ChargingText" Style="{StaticResource DarkTextBoxStyle}" MaxLength="7" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Margin="7,0,0,10"><TextBlock Text="Fully charged" Style="{StaticResource SecondaryLabel}"/>
      <TextBox x:Name="FullText" Style="{StaticResource DarkTextBoxStyle}" MaxLength="7" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Margin="0,0,7,10"><TextBlock Text="Single colour" Style="{StaticResource SecondaryLabel}"/>
      <TextBox x:Name="StaticText" Style="{StaticResource DarkTextBoxStyle}" MaxLength="7" Margin="0,4,0,0"/></StackPanel>
    </UniformGrid>
    <TextBlock Text="Battery colour ranges (%)" Style="{StaticResource SettingLabel}" Margin="0,0,0,7"/>
    <UniformGrid Columns="3">
     <StackPanel Margin="0,0,6,0"><TextBlock Text="Very low below" Style="{StaticResource SecondaryLabel}"/>
      <TextBox x:Name="CriticalBelowText" Style="{StaticResource DarkTextBoxStyle}" MaxLength="3" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Margin="3,0,3,0"><TextBlock Text="Low below" Style="{StaticResource SecondaryLabel}"/>
      <TextBox x:Name="LowBelowText" Style="{StaticResource DarkTextBoxStyle}" MaxLength="3" Margin="0,4,0,0"/></StackPanel>
     <StackPanel Margin="6,0,0,0"><TextBlock Text="Medium below" Style="{StaticResource SecondaryLabel}"/>
      <TextBox x:Name="MediumBelowText" Style="{StaticResource DarkTextBoxStyle}" MaxLength="3" Margin="0,4,0,0"/></StackPanel>
    </UniformGrid>
    <TextBlock Text="Ranges must increase, from 10% up to 100%."
               Style="{StaticResource SecondaryLabel}" Margin="0,8,0,12"/>
   </StackPanel>
   <TextBlock x:Name="ValidationText" Foreground="#FFB7B7" FontSize="12"
              TextWrapping="Wrap" Margin="0,0,0,8" Visibility="Collapsed"
              AutomationProperties.LiveSetting="Assertive"/>
   <TextBlock Text="Colour changes are experimental. The controller's previous colour may not return until reconnecting."
              Style="{StaticResource SecondaryLabel}" TextWrapping="Wrap" Margin="0,2,0,15"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="Cancel" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Click="CancelClick"/>
    <Button Content="Save changes" MinWidth="115" Style="{StaticResource PrimaryButtonStyle}" Click="ApplyClick"/>
   </StackPanel>
  </StackPanel>
 </ScrollViewer>
</Window>